{
  "firestore": {
    "database": "(default)",
    "location": "asia-south2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "python314"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/api/v1/verification/project/crawl",
        "destination": "https://digiindia-student-innovation-platform-2.onrender.com/api/v1/verification/project/crawl",
        "type": 307
      },
      {
        "source": "/api/v1/verification/:path*",
        "destination": "https://digiindia-student-innovation-platform-2.onrender.com/api/v1/verification/:path*",
        "type": 307
      },
      {
        "source": "/api/v1/:path*",
        "destination": "https://digiindia-student-innovation-platform-2.onrender.com/api/v1/:path*",
        "type": 307
      }
    ],
    "rewrites": [
      {
        "source": "/api/v1/search/redirect**",
        "destination": "/redirect.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
